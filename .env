# ============================================================
# VoltPath Backend Configuration
# ============================================================

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ============================================================
# Database (PostgreSQL + PostGIS)
# ============================================================

DB_USER=postgres
DB_PASSWORD=Bharadwaj@1940
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voltpath_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================
# API Keys (Get from respective services)
# ============================================================

# Google Places API
GOOGLE_API_KEY="AIzaSyBlASgSzSGXbAsHEHIB8sQEGVK1xkJSQrc"
GOOGLE_RATE_LIMIT=50
GOOGLE_MAPS_API_KEY="AIzaSyAX69KDaHwIIsyiWFO4JwrQUzRaKWYszUA"


# Open Charge Map API
OCM_API_KEY="fe8effa8-fb60-461c-85fd-9299398e98af"

# Government API (NITI Aayog)
GOV_API_KEY="579b464db66ec23bdd0000011ecf3b2e02dc4c2d52d28321f155f112"

# ============================================================
# Rate Limiting Configuration
# ============================================================

# Max API calls per minute
RATE_LIMIT_GOOGLE=50
RATE_LIMIT_OCM=100
RATE_LIMIT_GOV=500

# Delay between API calls (milliseconds)
API_CALL_DELAY_MS=200

# ============================================================
# Cache Configuration
# ============================================================

# Cache expiry (days)
CACHE_EXPIRY_DAYS=7

# Adaptive search radii (meters)
SEARCH_RADII=5000,10000,20000,40000

# ============================================================
# Fuzzy Matching Configuration
# ============================================================

# Jaro-Winkler similarity threshold (0-1)
FUZZY_MATCH_THRESHOLD=0.80

# Min trust score for verified stations
MIN_TRUST_SCORE=50

# ============================================================
# Feature Flags
# ============================================================

# Enable/disable specific features
FEATURE_BATTERY_ROUTER=true
FEATURE_AMENITY_FILTERING=true
FEATURE_OFFLINE_PERSISTENCE=true
FEATURE_COMMUNITY_VERIFICATION=true

# ============================================================
# Logging
# ============================================================

# Log directory
LOG_DIR=./logs

# Log file rotation
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ============================================================
# Monitoring & Analytics
# ============================================================

# Enable monitoring
ENABLE_MONITORING=true

# APM Server (optional, for performance monitoring)
APM_SERVER_URL=http://localhost:8200
APM_SERVICE_NAME=voltpath-backend

# ============================================================
# Security
# ============================================================

# CORS settings
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
CORS_CREDENTIALS=true

# Request timeout (milliseconds)
REQUEST_TIMEOUT_MS=30000

# ============================================================
# Development Settings
# ============================================================

# Debug mode
DEBUG=voltpath:*

# Allow console logs in production (should be false)
CONSOLE_LOGS=true

# ============================================================
# DO NOT COMMIT REAL VALUES - USE SECRETS MANAGEMENT
# ============================================================
